{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "noob-draw.vercel.app" }],
      "destination": "https://www.angeldlt.dev/noob-draw",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/noob-draw/:path*", "destination": "/:path*" },
    { "source": "/noob-draw", "destination": "/" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
